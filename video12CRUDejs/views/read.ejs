<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="./styles/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-zinc-800 !p-10 text-white">

    <a class="text-blue-900 text-xl" href="/">Back to home</a>
    <h1 class="text-2xl text-zinc-900">All users</h1>
    <div class="users !mt-5 flex flex-wrap gap-5">


        <% users.forEach(function(user){ %>
            <div class="user max-w-52 !p-4 bg-zinc-900 rounded-lg max-h-62">
               <div class="h-1/2 w-full">
                <img src="<%=user.image%>" alt="" class="h-full w-full">
               </div>
                <h3 class="text-xl !mt-3"><%=user.name%></h3>
                <h5 class="text-zinc-600 text-sm"><%=user.email%></h5>
                <div class="flex gap-4">
                    <a class="text-gray-500" href="/edit/<%=user._id%>">Edit user</a>
                    <a class="text-red-500" href="/delete/<%=user._id%>">Delete</a>
                </div>
            </div>
            <%})%>


    </div>
</body>

</html>