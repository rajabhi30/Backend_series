<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">

        <div class="w-full flex justify-end">
            <a class="bg-red-700 py-1 px-3 rounded-md" href="/logout">Logout</a>
        </div>

      
        <h5 class="mb-5">Edit your post:- </h5>

        <form action="/update/<%=post._id%>" method="post">
            <textarea
                class="p-3 outline-none resize-none bg-transparent border-2 border-zinc-800 rounded-md w-1/3 block"
                placeholder="Change your mind 🧠.." name="content"><%=post.content%></textarea>
            <input type="Submit" value="Update" class="py-2 px-5 bg-gray-500 block rounded-md mt-2 w-45">
        </form>

            </div>
        </div>
    </div>
</body>

</html>