<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">

        <div class="w-full flex justify-end">
            <a class="bg-red-700 py-1 px-3 rounded-md" href="/logout">Logout</a>
        </div>

        <h3 class="text-2xl">Hello, <%=user.name%> ❤️</h3>
        <h5 class="mb-5">You can create a new post:- </h5>

        <form action="/post" method="post">
            <textarea
                class="p-3 outline-none resize-none bg-transparent border-2 border-zinc-800 rounded-md w-1/3 block"
                placeholder="What's on your mind 🧠" name="content"></textarea>
            <input type="Submit" value="Create" class="py-2 px-5 bg-yellow-500 block rounded-md mt-2 w-45">
        </form>

        <div class="posts mt-16">
            <h3 class="text-zinc-400">Your posts:- </h3>

            <div class="postcontainers mt-5 flex flex-col gap-5">

                <% user.posts.reverse().forEach(function(post){ %>
                    <div class="post rounded-md w-1/3 p-4 border-2 border-zinc-700 bg-zinc-800">
                        <h4 class="text-blue-700 mb-2">@<%= user.name %>
                        </h4>
                        <p class="text-sm tracking-tight">
                            <%= post.content %>
                        </p>
                        <small class="mt-2 inline-block"><%= post.likes.length%> 👍</small>
                        <div class="btns text-xs mt-2 flex gap-3">
                            <a class="text-blue-500" href="/like/<%= post._id%>">
                                <%= post.likes.indexOf(user._id) === -1 ? "Likes" : "Unlike"%>
                            </a>
                            <a class="text-zinc-500" href="/edit/<%= post._id%>">Edit</a>
                        </div>
                    </div>
                    <% }) %>
            </div>
        </div>
    </div>
</body>

</html>