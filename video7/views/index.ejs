<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="main w-full min-h-screen bg-zinc-900 text-white text-sm">
        <div class="form !p-10">
            <form action="/create" method="post">
                <input class=" !py-2 bg-zinc-800 block w-full !px-2 outline-none" type="text" name="topic" id="" placeholder="Heading goes here">
                <textarea class=" !py-2 bg-zinc-800 block w-full !mt-2 !px-2 outline-none" name="details" id="" placeholder="Details goes here"></textarea>
                <input type="submit" name="" id="" value="Create Task" class="!mt-2 bg-blue-400 rounded !px-4 !py-2">
            </form>
        </div>
        <div class="tasks !p-10 flex gap-3 flex-wrap">
            <% if(files.length >0){%>
            <% files.forEach(function(val){%>
                <div class="task min-w-72 !px-3 !py-2 rounded-md bg-zinc-800">
                <h1 class="text-white text-xl tracking-tighter"><%=val%></h1>
                <div class="flex justify-between">
                    <a class="text-blue-400 inline-block" href="/file/<%=val%>">Read More..</a>
                    <a class="text-zinc-700" href="/edit/<%=val%>">Edit filename</a>
                </div>
            </div>
           <%})%>
           <% } else { %>
            <h3 class="text-white-800"> No task yet</h3>
           <% } %>
        </div>
    </div>
    <script src="javascripts/script.js"></script>
</body>
</html>